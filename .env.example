# Modèle de configuration. Copier ce fichier en .env puis adapter les valeurs :
#   Windows : Copy-Item .env.example .env
#   Linux   : cp .env.example .env
# Le fichier .env ne doit jamais être versionné (il est dans .gitignore).

# Adresse de l'API qui reçoit les métriques.
# - Lancement local (python -m app.agent) : http://127.0.0.1:8000/metrics
# - Docker Compose : valeur imposée par docker-compose.yml (http://api:8000/metrics)
METRICS_ENDPOINT=http://127.0.0.1:8000/metrics

# Intervalle entre deux collectes, en secondes (doit être > 0)
COLLECTION_INTERVAL=5

# Délai maximal d'une requête HTTP vers l'API, en secondes (doit être > 0)
REQUEST_TIMEOUT=5